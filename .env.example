# Copy to .env for local development. On Vercel, add the same keys under
# Project Settings -> Environment Variables (the .env file is not deployed).

# --- Database (Neon Postgres) -------------------------------------------------
# Direct connection: used by `npm run db:migrate` to create the tables.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
# Pooled connection (host contains "-pooler"): used by the API at runtime.
DATABASE_URL_POOLED=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# --- Comments ------------------------------------------------------------------
# Secret used to sign comment login tokens. At least 32 characters; keep it private.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs everyone out of comments (they log back in automatically).
COMMENTS_JWT_SECRET=

# Comma-separated AniList user IDs that get admin rights (delete any comment, ban users).
# Find an ID at https://anilist.co/user/<name> -> the number in the page's API data,
# or ask me to look it up.
COMMENTS_ADMIN_ANILIST_IDS=

# Optional: Telegram bot that receives a message for every new comment report
# (same bot/chat as the GitHub build posts is fine).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Updates -------------------------------------------------------------------
# Optional: GitHub token (no scopes needed) to raise the GitHub API rate limit used by
# /api/updates/stable and /api/updates/beta. Works without it.
GITHUB_TOKEN=
