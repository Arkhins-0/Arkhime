<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/seriesEntryCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorPrimary"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/seriesEntryCover"
            android:layout_width="64dp"
            android:layout_height="92dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/roundedImageView"
            tools:ignore="ContentDescription"
            tools:srcCompat="@tools:sample/backgrounds/scenic" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/seriesEntryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/jakarta_bold"
                android:maxLines="2"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                tools:text="Attack on Titan Season 2" />

            <TextView
                android:id="@+id/seriesEntryMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="?attr/colorOutline"
                android:textSize="12sp"
                tools:text="TV · 2017 · 12 eps" />

            <TextView
                android:id="@+id/seriesEntryState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/jakarta_bold"
                android:singleLine="true"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                tools:text="Watching · 5 / 12 · ★ 8.5" />

            <LinearLayout
                android:id="@+id/seriesEntryControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/seriesEntryStatus"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="12dp"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_round_arrow_drop_down_24"
                        app:iconGravity="end"
                        app:iconPadding="2dp"
                        app:iconSize="18dp"
                        tools:text="Watching" />

                    <TextView
                        android:id="@+id/seriesEntryScore"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:contentDescription="@string/series_score"
                        android:fontFamily="@font/jakarta_bold"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="13sp"
                        tools:text="★ 8.5" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/seriesEntryMinus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/series_progress_minus"
                        app:srcCompat="@drawable/ic_minus"
                        app:tint="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/seriesEntryProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:contentDescription="@string/series_progress"
                        android:fontFamily="@font/jakarta_bold"
                        android:gravity="center"
                        android:minWidth="56dp"
                        android:paddingHorizontal="6dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp"
                        tools:text="5 / 12" />

                    <ImageButton
                        android:id="@+id/seriesEntryPlus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/series_progress_plus"
                        app:srcCompat="@drawable/ic_round_add_circle_outline_24"
                        app:tint="?attr/colorPrimary" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/seriesEntryAdd"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/series_add_to_list"
                android:textSize="12sp"
                android:visibility="gone"
                app:icon="@drawable/ic_round_add_circle_outline_24"
                app:iconSize="16dp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/seriesEntryBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="1000"
                app:indicatorColor="?attr/colorPrimary"
                app:trackColor="?attr/colorSurfaceContainerHighest"
                app:trackCornerRadius="2dp"
                app:trackThickness="3dp"
                tools:progress="400" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
