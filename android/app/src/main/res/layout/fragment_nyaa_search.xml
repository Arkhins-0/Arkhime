<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/nyaaSearchLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:hint="@string/search"
        app:boxBackgroundColor="?android:attr/colorBackground"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="28dp"
        app:boxCornerRadiusBottomStart="28dp"
        app:boxCornerRadiusTopEnd="28dp"
        app:boxCornerRadiusTopStart="28dp"
        app:boxStrokeColor="?attr/colorOnBackground"
        app:cursorColor="?attr/colorOnBackground"
        app:endIconDrawable="@drawable/ic_round_search_24"
        app:endIconMode="custom"
        app:endIconTint="?attr/colorOnBackground"
        app:hintAnimationEnabled="true"
        app:hintTextColor="?attr/colorOnBackground">

        <AutoCompleteTextView
            android:id="@+id/nyaaSearchInput"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/jakarta_bold"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingStart="24dp"
            android:paddingTop="0dp"
            android:paddingEnd="8dp"
            android:paddingBottom="0dp"
            android:singleLine="true"
            android:textSize="14sp"
            tools:ignore="LabelFor" />
    </com.google.android.material.textfield.TextInputLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/nyaaCategoryChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/nyaaFilterChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/nyaaSort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipIcon="@drawable/ic_round_sort_24"
                app:chipIconTint="?attr/colorOnSurfaceVariant"
                tools:text="Newest" />

            <com.google.android.material.chip.Chip
                android:id="@+id/nyaaTrack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/track_search"
                app:chipIcon="@drawable/ic_round_notifications_none_24"
                app:chipIconTint="?attr/colorOnSurfaceVariant" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/nyaaSwipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.arkhins.arkhime.FadingEdgeRecyclerView
                android:id="@+id/nyaaRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="8dp"
                android:paddingBottom="96dp"
                android:requiresFadingEdge="vertical"
                tools:listitem="@layout/item_nyaa_torrent" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <TextView
            android:id="@+id/nyaaEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/jakarta_semi_bold"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/nyaaProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
