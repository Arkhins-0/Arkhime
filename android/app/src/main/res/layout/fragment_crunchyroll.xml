<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/crSearchLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:hint="@string/search"
        app:boxBackgroundColor="?android:attr/colorBackground"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="28dp"
        app:boxCornerRadiusBottomStart="28dp"
        app:boxCornerRadiusTopEnd="28dp"
        app:boxCornerRadiusTopStart="28dp"
        app:boxStrokeColor="?attr/colorOnBackground"
        app:cursorColor="?attr/colorOnBackground"
        app:endIconDrawable="@drawable/ic_round_search_24"
        app:endIconMode="custom"
        app:endIconTint="?attr/colorOnBackground"
        app:hintAnimationEnabled="true"
        app:hintTextColor="?attr/colorOnBackground">

        <AutoCompleteTextView
            android:id="@+id/crSearchInput"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/jakarta_bold"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingStart="24dp"
            android:paddingTop="0dp"
            android:paddingEnd="8dp"
            android:paddingBottom="0dp"
            android:singleLine="true"
            android:textSize="14sp"
            tools:ignore="LabelFor" />
    </com.google.android.material.textfield.TextInputLayout>

    <HorizontalScrollView
        android:id="@+id/crChipsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/crModeChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/crTrack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/track_search"
                app:chipIcon="@drawable/ic_round_notifications_none_24"
                app:chipIconTint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </HorizontalScrollView>

    <Button
        android:id="@+id/crOpenSeries"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/jakarta_bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/cr_open"
        android:textAllCaps="false"
        android:visibility="gone"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_open_24"
        tools:visibility="visible" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/crSwipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.arkhins.arkhime.FadingEdgeRecyclerView
                android:id="@+id/crRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="96dp"
                android:requiresFadingEdge="vertical"
                tools:listitem="@layout/item_feed_row" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <TextView
            android:id="@+id/crEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/jakarta_semi_bold"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/crProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
