<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/torrentTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jakarta_bold"
            android:textIsSelectable="true"
            android:textSize="16sp"
            tools:text="Torrent name" />

        <TextView
            android:id="@+id/torrentInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            tools:text="Anime · 661.9 MiB · 2 days ago\n98 seeders · 0 leechers · 1571 downloads" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/torrentMagnet"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/jakarta_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/open_magnet"
                android:textAllCaps="false"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_round_magnet_24" />

            <Button
                android:id="@+id/torrentDownload"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:fontFamily="@font/jakarta_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/download_torrent"
                android:textAllCaps="false"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_download_24" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/torrentCopy"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:fontFamily="@font/jakarta_bold"
                android:text="@string/copy_magnet"
                android:textAllCaps="false"
                android:textColor="?attr/colorOnBackground"
                app:icon="@drawable/format_link_24"
                app:iconTint="?attr/colorOnBackground" />

            <Button
                android:id="@+id/torrentShare"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:fontFamily="@font/jakarta_bold"
                android:text="@string/share"
                android:textAllCaps="false"
                android:textColor="?attr/colorOnBackground"
                app:icon="@drawable/ic_round_share_24"
                app:iconTint="?attr/colorOnBackground" />

            <Button
                android:id="@+id/torrentOpenPage"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:fontFamily="@font/jakarta_bold"
                android:text="@string/open_on_nyaa"
                android:textAllCaps="false"
                android:textColor="?attr/colorOnBackground"
                app:icon="@drawable/ic_open_24"
                app:iconTint="?attr/colorOnBackground" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/torrentDetailsProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/torrentFilesHeader"
            style="@style/FeedSectionHeader"
            android:text="@string/files"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/torrentFiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/torrentDescriptionHeader"
            style="@style/FeedSectionHeader"
            android:text="@string/description"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/torrentDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/torrentCommentsHeader"
            style="@style/FeedSectionHeader"
            android:visibility="gone"
            tools:text="Comments"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/torrentComments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
